@IoTAssetTrack.Api_HostAddress = http://localhost:5197


# DEVICE ENDPOINTS

### Get All Devices with Pagination
GET {{IoTAssetTrack.Api_HostAddress}}/api/device?page=1&pageSize=10
Accept: application/json

### Get All Devices by Search Term
GET {{IoTAssetTrack.Api_HostAddress}}/api/device?search=device1
Accept: application/json

### Get All Devices by Group
GET {{IoTAssetTrack.Api_HostAddress}}/api/device?groupId=1
Accept: application/json

### Get All Devices by DeviceType
GET {{IoTAssetTrack.Api_HostAddress}}/api/device?deviceTypeId=1
Accept: application/json

### Get Device by ID
GET {{IoTAssetTrack.Api_HostAddress}}/api/device/1
Accept: application/json

### Create New Device
POST {{IoTAssetTrack.Api_HostAddress}}/api/device
Content-Type: application/json

{
  "serialNumber": "DEV-001",
  "name": "Temperature Sensor - Building A",
  "latitude": 40.7128,
  "longitude": -74.0060,
  "isActive": true,
  "firmwareId": 1,
  "groupId": 1
}

### Update Device
PUT {{IoTAssetTrack.Api_HostAddress}}/api/device/1
Content-Type: application/json

{
  "name": "Updated Device Name",
  "latitude": 40.7130,
  "longitude": -74.0065,
  "isActive": true,
  "firmwareId": 2
}

### Assign Device to Group
PATCH {{IoTAssetTrack.Api_HostAddress}}/api/device/1/group
Content-Type: application/json

{
  "groupId": 2
}

### Remove Device from Group
PATCH {{IoTAssetTrack.Api_HostAddress}}/api/device/1/group
Content-Type: application/json

{
  "groupId": null
}

### Search Devices by Location (within 10 km)
POST {{IoTAssetTrack.Api_HostAddress}}/api/device/search/location
Content-Type: application/json

{
  "latitude": 40.7128,
  "longitude": -74.0060,
  "radiusKm": 10,
  "isActive": true
}

### Search Devices by Location and Device Type
POST {{IoTAssetTrack.Api_HostAddress}}/api/device/search/location
Content-Type: application/json

{
  "latitude": 40.7128,
  "longitude": -74.0060,
  "radiusKm": 5,
  "deviceTypeId": 1,
  "isActive": true
}
